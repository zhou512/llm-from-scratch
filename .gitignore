# ---- 练习仓库（它是自己独立的 git 仓库）----
git-practice/demo-repo/
# PR 演练脚本生成的临时仓库，每次跑都会重建
git-practice/local-remote/workdir/

# ---- 候选项目调研用的临时下载 ----
_candidates/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 数据集与训练产物（体积大、可重新生成，不进仓库）----
data/
outputs/
out-*/
*.bin
*.pth
*.ckpt
*.pkl
*.log

# 例外：数据准备脚本必须进仓库，否则别人无法复现你的数据集
!projects/*/data/
!projects/*/data/*.py
!projects/*/data/README.md
