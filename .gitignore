# ---- 练习仓库（它是自己独立的 git 仓库）----
git-practice/demo-repo/
# PR 演练脚本生成的临时仓库，每次跑都会重建
git-practice/local-remote/workdir/

# ---- 候选项目调研用的临时下载 ----
_candidates/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 数据集与训练产物（体积大、可重新生成，不进仓库）----
data/
outputs/
out-*/
*.bin
*.pth
*.ckpt
*.pkl
*.log

# ---- Jupyter notebook ----
# .ipynb 是 JSON，git diff 看不出来你改了什么，review 起来很痛苦。
# 学习时可以用 notebook（配合 VS Code 的单元格体验更好），
# 但存进仓库的应该是 .py。详见 projects/02-makemore/notes/03-分段运行代码.md
*.ipynb
.ipynb_checkpoints/

# 例外：数据准备脚本必须进仓库，否则别人无法复现你的数据集
!projects/*/data/
!projects/*/data/*.py
!projects/*/data/README.md
